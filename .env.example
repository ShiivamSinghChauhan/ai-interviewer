# Copy to .env. Every *_API_KEYS takes several keys (key1,key2,key3): one is used until it hits a limit,
# then the next one takes over, and benched keys come back on their own.

GROQ_API_KEYS=
OPENROUTER_API_KEYS=
GEMINI_API_KEYS=
JEV_API_KEYS=
SCALEDOWN_API_KEYS=
# fish.audio/app/api-keys: the s2.1-pro-free model costs nothing
FISH_API_KEYS=
ELEVENLABS_API_KEYS=
# only for analysing private repos
GITHUB_TOKEN=

# Chains are tried left to right (provider:model|param=value). `python -m scripts.check_keys` shows what your keys can use.
LLM_CHAIN=groq:qwen/qwen3.8-27b,groq:openai/gpt-oss-120b|reasoning_effort=low,groq:openai/gpt-oss-20b|reasoning_effort=low,openrouter:google/gemma-4-31b-it:free
REPORT_LLM_CHAIN=groq:openai/gpt-oss-120b|reasoning_effort=medium,groq:qwen/qwen3.8-27b,openrouter:google/gemma-4-31b-it:free
DECISIONS_CHAIN=jev:jev-latest,scaledown:classify-1

# Default voice (each session can pick its own): edge | fish | elevenlabs | kokoro
TTS_ENGINE=fish
FISH_MODEL=s2.1-pro-free
FISH_LATENCY=balanced
ELEVENLABS_MODEL=eleven_v4_turbo

# Optional machine tuning
# STT_THREADS=3
# TTS_THREADS=3
# SPEAKER_REJECT_BELOW=0.45
# REFINE_WITH_GROQ_WHISPER=1
# PORT=8000

# Hosting: PUBLIC_DEMO=1 keeps no transcripts and locks the settings; MAX_SESSION_MIN caps each session.
# HF_TOKEN is only used by scripts/deploy_space.py.
# PUBLIC_DEMO=0
# MAX_SESSION_MIN=0
# HF_TOKEN=
